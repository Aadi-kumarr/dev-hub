{
  "name": "dev-hub-launcher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Starts Fintra, Nivesh Control Room and the hub together.",
  "scripts": {
    "prestart": "node scripts/check-mongo.mjs",
    "start": "node scripts/start-all.mjs",
    "app:fintra": "cd Fintra && npm run dev",
    "app:nivesh-api": "cd Nivesh-control-room\\backend && .venv\\Scripts\\python -m uvicorn app.main:app --port 8000",
    "app:nivesh-ui": "cd Nivesh-control-room\\frontend && npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "app:hub": "cd hub && npm run dev",
    "open-when-ready": "node scripts/open-when-ready.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "wait-on": "^9.5.1"
  }
}
